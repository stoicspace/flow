{
  "name": "@flowlens/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "obfuscate": "npx tsx scripts/obfuscate.ts",
    "build:prod": "npm run build && npm run obfuscate",
    "package": "electron-vite build && electron-builder --publish never",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "generate-hashes": "npx tsx scripts/generate-hashes.ts"
  },
  "dependencies": {
    "@flowlens/core": "*",
    "@flowlens/storage-sqlite": "*",
    "@flowlens/keystore-electron": "*",
    "@noble/ed25519": "^2.1.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "javascript-obfuscator": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
